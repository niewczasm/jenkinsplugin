<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:l="/lib/layout" xmlns:f="/lib/form">
    <l:pane width="2" title="Autotest Executors Status" id="host-monitor-status">
        <j:set var="hosts" value="${it.hosts}"/>
        
        <j:choose>
            <j:when test="${hosts.isEmpty()}">
                <div class="pane-content" style="padding: 8px; color: #666;">
                    No hosts monitored
                </div>
            </j:when>
            <j:otherwise>
                <table class="pane" style="width: 100%;">
                    <tbody>
                        <j:forEach var="host" items="${hosts}">
                            <tr class="host-monitor-row">
                                <td class="pane" style="padding: 6px;">
                                    <div style="display: flex; align-items: center; gap: 8px;">
                                        <div style="flex: 1; min-width: 0; overflow: hidden;">
                                            <div style="font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;"
                                                 title="${host.displayName}">
                                                ${host.displayName}
                                            </div>
                                            <j:set var="displayMsg" value="${host.displayMessage}"/>
                                            <j:if test="${!empty(displayMsg)}">
                                                <div style="font-size: 11px; color: #666; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;"
                                                     title="${displayMsg}">
                                                    ${displayMsg}
                                                </div>
                                            </j:if>
                                        </div>
                                        <div style="flex-shrink: 0;">
                                            <span class="status-badge-small ${host.statusClass}">
                                                ${host.status}
                                            </span>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        </j:forEach>
                    </tbody>
                </table>
            </j:otherwise>
        </j:choose>
    </l:pane>
    
    <style>
        #host-monitor-status .title-link {
            color: inherit;
            text-decoration: underline;
            cursor: pointer;
        }

        #host-monitor-status .title-link:hover {
            color: #0066cc;
        }

        #host-monitor-status .status-badge-small {
            display: inline-block;
            padding: 2px 6px;
            border-radius: 3px;
            font-size: 10px;
            font-weight: bold;
            text-transform: uppercase;
            white-space: nowrap;
        }
        
        #host-monitor-status .status-green {
            background-color: #d4edda;
            color: #155724;
        }

        #host-monitor-status .status-blue {
            background-color: #cfe2ff;
            color: #084298;
        }

        #host-monitor-status .status-yellow {
            background-color: #fff3cd;
            color: #856404;
        }

        #host-monitor-status .status-red {
            background-color: #f8d7da;
            color: #721c24;
        }

        #host-monitor-status .status-grey {
            background-color: #e2e3e5;
            color: #383d41;
        }
        
        #host-monitor-status .host-monitor-row:hover {
            background-color: #f5f5f5;
        }
    </style>

    <script type="text/javascript">
        // Make the widget title text clickable and styled like a link
        (function() {
            var widgetContainer = document.getElementById('host-monitor-status');
            if (widgetContainer) {
                var titleElement = widgetContainer.querySelector('.pane-header, .pane > .pane-header, h2');
                if (titleElement) {
                    // Find the text node within the title element
                    var textNode = null;
                    for (var i = 0; i &lt; titleElement.childNodes.length; i++) {
                        var node = titleElement.childNodes[i];
                        // nodeType 3 is TEXT_NODE
                        if (node.nodeType === 3 &amp;&amp; node.nodeValue.trim()) {
                            textNode = node;
                            break;
                        }
                    }

                    if (textNode) {
                        // Replace just the text node with an anchor tag
                        var rootUrl = (typeof window.rootURL !== 'undefined' &amp;&amp; window.rootURL) ? window.rootURL : '';
                        var linkElement = document.createElement('a');
                        linkElement.href = rootUrl + '/host-monitor';
                        linkElement.className = 'pane-header-title title-link';
                        linkElement.textContent = textNode.nodeValue.trim();
                        titleElement.replaceChild(linkElement, textNode);
                    }
                }
            }
        })();

        // Auto-refresh the host monitor status every 5 seconds
        (function() {
            var refreshInterval = 5000; // 5 seconds
            var widgetContainer = document.getElementById('host-monitor-status');
            var COLLAPSE_STATE_KEY = 'hostMonitorCollapseState';

            // Helper function to get content elements
            function getContentElements() {
                if (!widgetContainer) return [];

                var elements = [];
                // Get the table (main content)
                var table = widgetContainer.querySelector('table');
                if (table) elements.push(table);

                // Get any pane-content divs
                var paneContent = widgetContainer.querySelectorAll('.pane-content');
                paneContent.forEach(function(el) { elements.push(el); });

                return elements;
            }

            // Helper function to check if content is actually collapsed
            function isContentCollapsed() {
                var contentElements = getContentElements();
                if (contentElements.length === 0) return false;

                for (var i = 0; i &lt; contentElements.length; i++) {
                    var style = window.getComputedStyle(contentElements[i]);
                    if (style.display !== 'none') {
                        return false; // At least one element is visible
                    }
                }
                return true; // All content is hidden
            }

            // Helper function to get saved collapse state
            function getSavedCollapseState() {
                try {
                    return localStorage.getItem(COLLAPSE_STATE_KEY) === 'true';
                } catch (e) {
                    return false;
                }
            }

            // Helper function to set collapse state
            function setCollapseState(collapsed) {
                try {
                    localStorage.setItem(COLLAPSE_STATE_KEY, collapsed ? 'true' : 'false');
                } catch (e) {
                    // Ignore localStorage errors
                }
            }

            // Function to enforce collapse state
            function enforceCollapseState() {
                var shouldBeCollapsed = getSavedCollapseState();
                var isCurrentlyCollapsed = isContentCollapsed();

                if (shouldBeCollapsed &amp;&amp; !isCurrentlyCollapsed) {
                    // Should be collapsed but isn't - collapse it
                    var contentElements = getContentElements();
                    contentElements.forEach(function(el) {
                        el.style.display = 'none';
                    });
                }
            }

            // Monitor clicks on the widget header to detect collapse/expand
            function setupCollapseListener() {
                if (!widgetContainer) return;

                // Find the pane header (clickable title area)
                var header = widgetContainer.querySelector('.pane-header');
                if (!header) {
                    // Try to find h2 or other header elements
                    var parent = widgetContainer.parentElement;
                    while (parent) {
                        header = parent.querySelector('h2');
                        if (header) break;
                        parent = parent.parentElement;
                        if (parent &amp;&amp; parent.id === 'side-panel') break;
                    }
                }

                if (header) {
                    header.addEventListener('click', function(e) {
                        // Wait a moment for Jenkins to process the collapse
                        setTimeout(function() {
                            var collapsed = isContentCollapsed();
                            setCollapseState(collapsed);
                        }, 100);
                    });
                }
            }

            function createHostRow(host) {
                var tr = document.createElement('tr');
                tr.className = 'host-monitor-row';

                var td = document.createElement('td');
                td.className = 'pane';
                td.style.padding = '6px';

                var flexDiv = document.createElement('div');
                flexDiv.style.display = 'flex';
                flexDiv.style.alignItems = 'center';
                flexDiv.style.gap = '8px';

                var infoDiv = document.createElement('div');
                infoDiv.style.flex = '1';
                infoDiv.style.minWidth = '0';
                infoDiv.style.overflow = 'hidden';

                var hostnameDiv = document.createElement('div');
                hostnameDiv.style.fontWeight = '500';
                hostnameDiv.style.whiteSpace = 'nowrap';
                hostnameDiv.style.overflow = 'hidden';
                hostnameDiv.style.textOverflow = 'ellipsis';
                hostnameDiv.title = host.hostname;
                hostnameDiv.textContent = host.hostname;

                infoDiv.appendChild(hostnameDiv);

                if (host.displayMessage) {
                    var messageDiv = document.createElement('div');
                    messageDiv.style.fontSize = '11px';
                    messageDiv.style.color = '#666';
                    messageDiv.style.whiteSpace = 'nowrap';
                    messageDiv.style.overflow = 'hidden';
                    messageDiv.style.textOverflow = 'ellipsis';
                    messageDiv.title = host.displayMessage;
                    messageDiv.textContent = host.displayMessage;
                    infoDiv.appendChild(messageDiv);
                }

                var statusDiv = document.createElement('div');
                statusDiv.style.flexShrink = '0';

                var statusBadge = document.createElement('span');
                statusBadge.className = 'status-badge-small ' + host.statusClass;
                statusBadge.textContent = host.status;

                statusDiv.appendChild(statusBadge);
                flexDiv.appendChild(infoDiv);
                flexDiv.appendChild(statusDiv);
                td.appendChild(flexDiv);
                tr.appendChild(td);

                return tr;
            }

            function refreshHostMonitor() {
                if (!widgetContainer) return;

                // Check if should be collapsed - if so, don't update
                if (getSavedCollapseState()) {
                    // Enforce collapse state in case it got expanded
                    enforceCollapseState();
                    return;
                }

                var rootUrl = (typeof window.rootURL !== 'undefined' &amp;&amp; window.rootURL) ? window.rootURL : '';

                // Fetch updated host data from JSON endpoint
                fetch(rootUrl + '/host-monitor/hostsJson', {
                    headers: {
                        'Accept': 'application/json'
                    }
                })
                .then(function(response) {
                    if (response.ok) {
                        return response.json();
                    }
                    throw new Error('Failed to fetch host monitor data');
                })
                .then(function(data) {
                    // Check again before updating DOM
                    if (getSavedCollapseState()) {
                        enforceCollapseState();
                        return;
                    }

                    var hosts = data.hosts;
                    var tableBody = widgetContainer.querySelector('tbody');

                    if (hosts.length === 0) {
                        // Show "no hosts" message
                        var noHostsDiv = document.createElement('div');
                        noHostsDiv.className = 'pane-content';
                        noHostsDiv.style.padding = '8px';
                        noHostsDiv.style.color = '#666';
                        noHostsDiv.textContent = 'No hosts monitored';

                        var table = widgetContainer.querySelector('table');
                        if (table) {
                            table.parentNode.replaceChild(noHostsDiv, table);
                        }
                    } else {
                        // Update table with new hosts
                        if (!tableBody) {
                            // Create table if it doesn't exist
                            var paneContent = widgetContainer.querySelector('.pane-content');
                            if (paneContent) {
                                var table = document.createElement('table');
                                table.className = 'pane';
                                table.style.width = '100%';
                                tableBody = document.createElement('tbody');
                                table.appendChild(tableBody);
                                paneContent.parentNode.replaceChild(table, paneContent);
                            }
                        }

                        if (tableBody) {
                            // Clear existing rows
                            tableBody.innerHTML = '';

                            // Add new rows
                            hosts.forEach(function(host) {
                                tableBody.appendChild(createHostRow(host));
                            });
                        }
                    }
                })
                .catch(function(error) {
                    console.error('Host monitor refresh error:', error);
                });
            }

            // Setup collapse state listener
            setupCollapseListener();

            // Enforce initial collapse state
            enforceCollapseState();

            // Start auto-refresh with collapse enforcement
            if (widgetContainer) {
                setInterval(function() {
                    enforceCollapseState();
                    refreshHostMonitor();
                }, refreshInterval);
            }
        })();
    </script>
</j:jelly>
