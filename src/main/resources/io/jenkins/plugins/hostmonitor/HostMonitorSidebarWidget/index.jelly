<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:l="/lib/layout" xmlns:f="/lib/form">
    <l:pane width="2" title="Autotest Executors Status" id="host-monitor-status">
        <j:set var="hosts" value="${it.hosts}"/>
        
        <j:choose>
            <j:when test="${hosts.isEmpty()}">
                <div class="pane-content" style="padding: 8px; color: #666;">
                    No hosts monitored
                </div>
            </j:when>
            <j:otherwise>
                <table class="pane" style="width: 100%;">
                    <tbody>
                        <j:forEach var="host" items="${hosts}">
                            <tr class="host-monitor-row">
                                <td class="pane" style="padding: 6px;">
                                    <div style="display: flex; align-items: center; gap: 8px;">
                                        <div style="flex: 1; min-width: 0; overflow: hidden;">
                                            <div style="font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;"
                                                 title="${host.hostname}">
                                                ${host.hostname}
                                            </div>
                                            <j:set var="displayMsg" value="${host.displayMessage}"/>
                                            <j:if test="${!empty(displayMsg)}">
                                                <div style="font-size: 11px; color: #666; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;"
                                                     title="${displayMsg}">
                                                    ${displayMsg}
                                                </div>
                                            </j:if>
                                        </div>
                                        <div style="flex-shrink: 0;">
                                            <span class="status-badge-small ${host.statusClass}">
                                                ${host.status}
                                            </span>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        </j:forEach>
                    </tbody>
                </table>
            </j:otherwise>
        </j:choose>
    </l:pane>
    
    <style>
        #host-monitor-status .status-badge-small {
            display: inline-block;
            padding: 2px 6px;
            border-radius: 3px;
            font-size: 10px;
            font-weight: bold;
            text-transform: uppercase;
            white-space: nowrap;
        }
        
        #host-monitor-status .status-green {
            background-color: #d4edda;
            color: #155724;
        }

        #host-monitor-status .status-blue {
            background-color: #cfe2ff;
            color: #084298;
        }

        #host-monitor-status .status-yellow {
            background-color: #fff3cd;
            color: #856404;
        }

        #host-monitor-status .status-red {
            background-color: #f8d7da;
            color: #721c24;
        }

        #host-monitor-status .status-grey {
            background-color: #e2e3e5;
            color: #383d41;
        }
        
        #host-monitor-status .host-monitor-row:hover {
            background-color: #f5f5f5;
        }
    </style>

    <script type="text/javascript">
        // Auto-refresh the host monitor status every 5 seconds
        (function() {
            var refreshInterval = 5000; // 5 seconds
            var widgetContainer = document.getElementById('host-monitor-status');

            function createHostRow(host) {
                var tr = document.createElement('tr');
                tr.className = 'host-monitor-row';

                var td = document.createElement('td');
                td.className = 'pane';
                td.style.padding = '6px';

                var flexDiv = document.createElement('div');
                flexDiv.style.display = 'flex';
                flexDiv.style.alignItems = 'center';
                flexDiv.style.gap = '8px';

                var infoDiv = document.createElement('div');
                infoDiv.style.flex = '1';
                infoDiv.style.minWidth = '0';
                infoDiv.style.overflow = 'hidden';

                var hostnameDiv = document.createElement('div');
                hostnameDiv.style.fontWeight = '500';
                hostnameDiv.style.whiteSpace = 'nowrap';
                hostnameDiv.style.overflow = 'hidden';
                hostnameDiv.style.textOverflow = 'ellipsis';
                hostnameDiv.title = host.hostname;
                hostnameDiv.textContent = host.hostname;

                infoDiv.appendChild(hostnameDiv);

                if (host.displayMessage) {
                    var messageDiv = document.createElement('div');
                    messageDiv.style.fontSize = '11px';
                    messageDiv.style.color = '#666';
                    messageDiv.style.whiteSpace = 'nowrap';
                    messageDiv.style.overflow = 'hidden';
                    messageDiv.style.textOverflow = 'ellipsis';
                    messageDiv.title = host.displayMessage;
                    messageDiv.textContent = host.displayMessage;
                    infoDiv.appendChild(messageDiv);
                }

                var statusDiv = document.createElement('div');
                statusDiv.style.flexShrink = '0';

                var statusBadge = document.createElement('span');
                statusBadge.className = 'status-badge-small ' + host.statusClass;
                statusBadge.textContent = host.status;

                statusDiv.appendChild(statusBadge);
                flexDiv.appendChild(infoDiv);
                flexDiv.appendChild(statusDiv);
                td.appendChild(flexDiv);
                tr.appendChild(td);

                return tr;
            }

            function refreshHostMonitor() {
                if (!widgetContainer) return;

                var rootUrl = (typeof window.rootURL !== 'undefined' &amp;&amp; window.rootURL) ? window.rootURL : '';

                // Fetch updated host data from JSON endpoint
                fetch(rootUrl + '/host-monitor/hostsJson', {
                    headers: {
                        'Accept': 'application/json'
                    }
                })
                .then(function(response) {
                    if (response.ok) {
                        return response.json();
                    }
                    throw new Error('Failed to fetch host monitor data');
                })
                .then(function(data) {
                    var hosts = data.hosts;
                    var tableBody = widgetContainer.querySelector('tbody');

                    if (hosts.length === 0) {
                        // Show "no hosts" message
                        var noHostsDiv = document.createElement('div');
                        noHostsDiv.className = 'pane-content';
                        noHostsDiv.style.padding = '8px';
                        noHostsDiv.style.color = '#666';
                        noHostsDiv.textContent = 'No hosts monitored';

                        var table = widgetContainer.querySelector('table');
                        if (table) {
                            table.parentNode.replaceChild(noHostsDiv, table);
                        }
                    } else {
                        // Update table with new hosts
                        if (!tableBody) {
                            // Create table if it doesn't exist
                            var paneContent = widgetContainer.querySelector('.pane-content');
                            if (paneContent) {
                                var table = document.createElement('table');
                                table.className = 'pane';
                                table.style.width = '100%';
                                tableBody = document.createElement('tbody');
                                table.appendChild(tableBody);
                                paneContent.parentNode.replaceChild(table, paneContent);
                            }
                        }

                        if (tableBody) {
                            // Clear existing rows
                            tableBody.innerHTML = '';

                            // Add new rows
                            hosts.forEach(function(host) {
                                tableBody.appendChild(createHostRow(host));
                            });
                        }
                    }
                })
                .catch(function(error) {
                    console.error('Host monitor refresh error:', error);
                });
            }

            // Start auto-refresh
            if (widgetContainer) {
                setInterval(refreshHostMonitor, refreshInterval);
            }
        })();
    </script>
</j:jelly>
