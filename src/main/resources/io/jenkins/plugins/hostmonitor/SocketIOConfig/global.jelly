<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
    <f:section title="Host Monitor - Socket.IO Integration">
        <f:entry title="Enable Socket.IO" field="enabled">
            <f:checkbox />
        </f:entry>
        
        <f:advanced>
            <f:entry title="Server Host" field="serverHost">
                <f:textbox default="localhost" />
            </f:entry>
            
            <f:entry title="Server Port" field="serverPort">
                <f:number default="3000" min="1" max="65535" />
            </f:entry>
            
            <f:entry title="Namespace" field="namespace">
                <f:textbox default="/" />
            </f:entry>
            
            <f:entry title="Event Name" field="eventName">
                <f:textbox default="hostStatus" />
            </f:entry>
        </f:advanced>
        
        <f:block>
            <div style="margin-top: 10px; padding: 10px; background-color: #f0f0f0; border-left: 4px solid #4a90e2;">
                <strong>Socket.IO Message Format:</strong>
                <pre style="margin-top: 5px; background-color: white; padding: 8px; border-radius: 3px;">
{
  "hostname": "server1.example.com",
  "status": "ONLINE",
  "message": "All services running"
}</pre>
                <p style="margin-top: 8px; font-size: 12px; color: #666;">
                    The plugin will listen for events on the specified namespace and event name.
                    Status values: ONLINE, UP, HEALTHY (green), WARNING, DEGRADED (yellow), 
                    OFFLINE, DOWN, ERROR (red), or any custom value (grey).
                </p>
            </div>
        </f:block>
    </f:section>
</j:jelly>
