<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:l="/lib/layout" xmlns:f="/lib/form">
    <l:layout title="Host Monitor Configuration" permission="${app.ADMINISTER}">
        <st:include page="sidepanel.jelly" it="${app}"/>
        <l:main-panel>
            <h1>Host Monitor Configuration</h1>

            <!-- Socket.IO Configuration Form -->
            <f:form method="post" action="configSubmit">
                <f:section title="Socket.IO Integration">
                    <j:set var="socketIOStatus" value="${it.socketIOStatus}"/>

                    <div style="margin-bottom: 15px;">
                        <table style="border: none;">
                            <tr>
                                <td style="padding: 4px 12px 4px 0; font-weight: bold;">Connection Status:</td>
                                <td style="padding: 4px;">
                                    <j:choose>
                                        <j:when test="${socketIOStatus == 'Connected'}">
                                            <span style="color: #155724; background-color: #d4edda; padding: 2px 8px; border-radius: 3px; font-weight: bold;">
                                                ✓ ${socketIOStatus}
                                            </span>
                                        </j:when>
                                        <j:when test="${socketIOStatus == 'Disabled'}">
                                            <span style="color: #666; background-color: #e2e3e5; padding: 2px 8px; border-radius: 3px;">
                                                ${socketIOStatus}
                                            </span>
                                        </j:when>
                                        <j:otherwise>
                                            <span style="color: #856404; background-color: #fff3cd; padding: 2px 8px; border-radius: 3px;">
                                                ${socketIOStatus}
                                            </span>
                                        </j:otherwise>
                                    </j:choose>
                                </td>
                            </tr>
                            <j:if test="${it.socketIOEnabled}">
                                <tr>
                                    <td style="padding: 4px 12px 4px 0; font-weight: bold;">Server URL:</td>
                                    <td style="padding: 4px;"><code>${it.socketIOServerUrl}</code></td>
                                </tr>
                                <tr>
                                    <td style="padding: 4px 12px 4px 0; font-weight: bold;">Event Name:</td>
                                    <td style="padding: 4px;"><code>${it.socketIOEventName}</code></td>
                                </tr>
                            </j:if>
                        </table>
                    </div>

                    <f:entry title="Enable Socket.IO" field="socketIOEnabled">
                        <f:checkbox name="socketIOEnabled" checked="${it.socketIOEnabled}"/>
                    </f:entry>

                    <f:entry title="Server Host" field="socketIOHost">
                        <f:textbox name="socketIOHost" value="${it.socketIOHost}" default="localhost"/>
                    </f:entry>

                    <f:entry title="Server Port" field="socketIOPort">
                        <f:number name="socketIOPort" value="${it.socketIOPort}" min="1" max="65535" default="3000"/>
                    </f:entry>

                    <f:entry title="Namespace" field="socketIONamespace">
                        <f:textbox name="socketIONamespace" value="${it.socketIONamespace}" default="/"/>
                    </f:entry>

                    <f:entry title="Event Name" field="socketIOEventName">
                        <f:textbox name="socketIOEventName" value="${it.socketIOEventName}" default="hostStatus"/>
                    </f:entry>

                    <div style="margin-top: 10px; padding: 10px; background-color: #f0f0f0; border-left: 4px solid #4a90e2;">
                        <strong>Socket.IO Message Format:</strong>
                        <pre style="margin-top: 5px; background-color: white; padding: 8px; border-radius: 3px; font-size: 12px;">
{
  "hostname": "server1.example.com",
  "status": "ONLINE",
  "message": "All services running"
}</pre>
                        <p style="margin: 8px 0 0 0; font-size: 12px; color: #666;">
                            The plugin will listen for events on the specified namespace and event name.
                            Status values: ONLINE, UP, HEALTHY (green), WARNING, DEGRADED (yellow),
                            OFFLINE, DOWN, ERROR (red), or any custom value (grey).
                        </p>
                    </div>

                    <f:block>
                        <div style="margin-top: 15px;">
                            <f:submit value="Save Configuration"/>
                        </div>
                    </f:block>
                </f:section>
            </f:form>

            <p style="margin-top: 30px;">
                This page displays all currently monitored hosts.
                You can update host status from Jenkins Pipeline using the <code>updateHostStatus</code> step,
                or enable Socket.IO above for real-time updates.
            </p>

            <h2>Monitored Hosts</h2>
            
            <j:set var="hosts" value="${it.hosts}"/>
            
            <j:choose>
                <j:when test="${hosts.isEmpty()}">
                    <p>No hosts are currently being monitored.</p>
                    <p>Add hosts by using the <code>updateHostStatus</code> step in your Jenkins Pipeline:</p>
                    <pre>
updateHostStatus hostname: 'server1.example.com', status: 'ONLINE', message: 'All services running'
                    </pre>
                </j:when>
                <j:otherwise>
                    <table class="pane bigtable sortable">
                        <thead>
                            <tr>
                                <th class="pane-header">Hostname</th>
                                <th class="pane-header">Status</th>
                                <th class="pane-header">Message</th>
                                <th class="pane-header">Last Updated</th>
                            </tr>
                        </thead>
                        <tbody>
                            <j:forEach var="host" items="${hosts}">
                                <tr>
                                    <td class="pane">${host.hostname}</td>
                                    <td class="pane">
                                        <span class="status-badge ${host.statusClass}">
                                            ${host.status}
                                        </span>
                                    </td>
                                    <td class="pane">${host.statusMessage}</td>
                                    <td class="pane">
                                        <j:invoke on="${host.lastUpdatedDate}" method="toString" var="timestamp"/>
                                        ${timestamp}
                                    </td>
                                </tr>
                            </j:forEach>
                        </tbody>
                    </table>
                </j:otherwise>
            </j:choose>
            
            <h2>Pipeline Usage</h2>
            <p>Use the following step in your Jenkinsfile to update host status:</p>
            
            <h3>Declarative Pipeline</h3>
            <pre>
pipeline {
    agent any
    stages {
        stage('Monitor Hosts') {
            steps {
                script {
                    // Update host status
                    updateHostStatus hostname: 'web-server-01', 
                                    status: 'ONLINE', 
                                    message: 'HTTP 200 OK'
                    
                    // Different status types
                    updateHostStatus hostname: 'db-server-01', 
                                    status: 'WARNING', 
                                    message: 'High CPU usage'
                    
                    updateHostStatus hostname: 'api-server-01', 
                                    status: 'OFFLINE', 
                                    message: 'Connection timeout'
                }
            }
        }
    }
}
            </pre>
            
            <h3>Scripted Pipeline</h3>
            <pre>
node {
    stage('Check Hosts') {
        updateHostStatus hostname: 'prod-server', 
                        status: 'HEALTHY', 
                        message: 'All checks passed'
    }
}
            </pre>
            
            <h3>Status Values</h3>
            <ul>
                <li><strong>ONLINE/UP/HEALTHY</strong> - Displayed in green</li>
                <li><strong>WARNING/DEGRADED</strong> - Displayed in yellow</li>
                <li><strong>OFFLINE/DOWN/ERROR</strong> - Displayed in red</li>
                <li><strong>UNKNOWN</strong> or any other value - Displayed in grey</li>
            </ul>
        </l:main-panel>
    </l:layout>
</j:jelly>
